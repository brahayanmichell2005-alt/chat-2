# Plantilla para la nube. Copie como `.env` (en el mismo directorio) y complete.
# NUNCA lo suba a git ya está en .gitignore (.env.*). Generar secretos:
#   Linux: openssl rand -hex 32
#   Windows: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Nombres de dominio (necesita su propio dominio para Caddy/Vercel) ─────────
# Subdominio que apuntará (A record) a la IP de la VPS; Caddy emite el certificado solo.
API_DOMAIN=api.tudominio.com
# URL final de la app en Vercel (para CORS). Si usa dominio propio en Vercel, póngalo aquí.
FRONTEND_URL=https://tu-app.vercel.app
APP_BASE_URL=https://tu-app.vercel.app

# ── Secretos (GENERAR NUEVOS, no reutilizar los de desarrollo local) ──────────
JWT_ACCESS_SECRET=
POSTGRES_PASSWORD=

# ── WhatsApp ───────────────────────────────────────────────────────────────────
# Hasta terminar las pruebas, deje allowlist con su(s) número(s) de pruebas.
WHATSAPP_SEND_MODE=off
WHATSAPP_ALLOWED_NUMBERS=
# true = reconecta solo tras reiniciar la VPS (active cuando la sesión ya esté vinculada)
WHATSAPP_AUTOCONNECT=

# ── IA ─────────────────────────────────────────────────────────────────────────
# ollama = servidor Ollama (local/en VPS); openai = nivel gratuito de Groq/Gemini/OpenRouter.
# Con "openai": consiga su clave gratis y póngala aquí. Luego, en el Panel → IA fije:
#   Groq       baseUrl: https://api.groq.com/openai/v1   modelo: llama-3.3-70b-versatile
#   Gemini     baseUrl: https://generativelanguage.googleapis.com/v1beta/openai   modelo: gemini-2.5-flash
#   OpenRouter baseUrl: https://openrouter.ai/api/v1     modelo: ver [free] en openrouter.ai/models
AI_PROVIDER=ollama
AI_API_KEY=
