# Copiar a .env y completar. NUNCA subir .env al repositorio.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://crm:CAMBIAR_PASSWORD@127.0.0.1:5432/crm
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=America/Lima
LOG_LEVEL=info

# Secreto JWT: mínimo 32 caracteres aleatorios (ej.: openssl rand -base64 48)
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# En producción debe ser true (HTTPS). Si se omite: true solo en production.
COOKIE_SECURE=
# Poner 1 si hay proxy inverso delante del backend
TRUST_PROXY=0

# WhatsApp (Etapa 4)
WHATSAPP_SESSION_PATH=./whatsapp-session
# off (por defecto, no envía nada) | allowlist (solo a los números de abajo) | all (cualquier número; solo tras las pruebas)
WHATSAPP_SEND_MODE=off
# Números permitidos para pruebas, solo dígitos con código de país, separados por coma (ej.: 51900000000)
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_MIN_SEND_INTERVAL_MS=1500
WHATSAPP_MAX_PER_MINUTE=20
# true = reconectar al iniciar el backend si ya hay una sesión guardada
WHATSAPP_AUTOCONNECT=false

# Solo para `npm run seed:admin` (se usan una vez; no dejar la contraseña guardada)
ADMIN_EMAIL=
ADMIN_NAME=Administrador
ADMIN_PASSWORD=

# Pruebas de integración (base separada, se vacían sus tablas)
TEST_DATABASE_URL=
